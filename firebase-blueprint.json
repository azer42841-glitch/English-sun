{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or user profile",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "placementLevel": { "type": "string", "maxLength": 5 }
      },
      "required": ["name", "email", "createdAt"]
    },
    "LevelAccess": {
      "title": "LevelAccess",
      "description": "Level access permission for student",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 5 },
        "grantedBy": { "type": "string", "maxLength": 100 },
        "grantedAt": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "expiresAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["studentUid", "studentName", "level", "grantedBy", "grantedAt"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Student lesson completion and quiz progress",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "completedLessons": { "type": "array" },
        "quizScores": { "type": "object" }
      },
      "required": ["userId"]
    },
    "PlacementResult": {
      "title": "PlacementResult",
      "description": "Placement test result and 4 skills scores",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "readingScore": { "type": "number" },
        "listeningScore": { "type": "number" },
        "writingScore": { "type": "number" },
        "speakingScore": { "type": "number" },
        "recommendedLevel": { "type": "string", "maxLength": 5 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "recommendedLevel"]
    },
    "VideoItem": {
      "title": "VideoItem",
      "description": "Educational video item",
      "type": "object",
      "properties": {
        "level": { "type": "string", "maxLength": 5 },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 500 },
        "skill": { "type": "string", "maxLength": 50 },
        "lessonRef": { "type": "string", "maxLength": 100 }
      },
      "required": ["level", "title", "url"]
    },
    "Message": {
      "title": "Message",
      "description": "Contact message from student",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "subject", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/levelAccess/{accessId}": {
      "schema": "LevelAccess",
      "description": "Level access grants for students"
    },
    "/progress/{userId}": {
      "schema": "Progress",
      "description": "Student progress record"
    },
    "/placementResults/{resultId}": {
      "schema": "PlacementResult",
      "description": "Placement test results"
    },
    "/videos/{videoId}": {
      "schema": "VideoItem",
      "description": "Protected educational videos"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Contact messages inbox"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrator records"
    }
  }
}
