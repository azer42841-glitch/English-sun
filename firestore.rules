rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Has level access or A1 free
    function hasLevelAccess(userId, level) {
      return level == 'A1' || exists(/databases/$(database)/documents/levelAccess/$(userId + '_' + level));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().name is string && incoming().name.size() <= 100 && incoming().email is string && incoming().email.size() <= 150;
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'placementLevel']);
      allow delete: if isAdmin();
    }

    // Level Access collection
    match /levelAccess/{accessId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Progress collection
    match /progress/{userId} {
      allow get, list, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Placement Results
    match /placementResults/{resultId} {
      allow get, list, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Videos collection (Protected content based on level access)
    match /videos/{videoId} {
      allow get, list: if isSignedIn() && (isAdmin() || hasLevelAccess(request.auth.uid, resource.data.level));
      allow create, update, delete: if isAdmin();
    }

    // Messages (Contact inbox)
    match /messages/{messageId} {
      allow create: if incoming().name is string && incoming().name.size() <= 100 && incoming().email is string && incoming().email.size() <= 150 && incoming().subject is string && incoming().subject.size() <= 200 && incoming().message is string && incoming().message.size() <= 1000;
      allow get, list, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
